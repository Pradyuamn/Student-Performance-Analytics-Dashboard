      <aliases enabled='yes' />
      <column caption='Avg Score ' datatype='real' name='[Calculation_0750413901283328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([math score]+[writing score]+[reading score])/3' />
      </column>
      <column caption='Performance Category' datatype='string' name='[Calculation_0750413901750273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0750413901283328] &gt;= 75 THEN &quot;High Performer&quot;&#10;ELSEIF [Calculation_0750413901283328] &gt;= 50 THEN &quot;Average&quot;&#10;ELSE &quot;At Risk&quot;&#10;END' />
      </column>
      <column caption='Pass/Fail' datatype='string' name='[Calculation_0750413901893634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0750413901283328] &gt;= 40 THEN &quot;Pass&quot;&#10;ELSE &quot;Fail&quot;&#10;END' />
      </column>
      <column caption='Score Gap' datatype='integer' name='[Calculation_0750413902045187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[math score]-[reading score]' />
      </column>
      <column caption='Pass Percentage' datatype='real' name='[Calculation_0750413902368772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0750413901893634] = &quot;Pass&quot; THEN 1 ELSE 0 END) &#10;/ COUNT([Calculation_0750413901283328])' />
      </column>
      <column caption='At Risk' datatype='real' datatype-customized='true' default-format='p0.00%' name='[Calculation_0750413903478790]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0750413901750273] = &quot;At Risk&quot; THEN 1 END)&#10;/ COUNT([Calculation_0750413901283328])' />
      </column>
      <column caption='Risk Color' datatype='string' name='[Calculation_0761409022369792]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0750413903478790] &gt; 0.2 THEN &quot;High Risk&quot;&#10;ELSEIF [Calculation_0750413903478790] &gt; 0.1 THEN &quot;Moderate&quot;&#10;ELSE &quot;Low Risk&quot;&#10;END' />
      </column>
      <column caption='Test Prep Impact %' datatype='real' name='[Calculation_0761409024847873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;AVG(IF [test preparation course] = &quot;Completed&quot; THEN [Calculation_0750413901283328] END)&#10;-&#10;AVG(IF [test preparation course] = &quot;None&quot; THEN [Calculation_0750413901283328] END)&#10;)&#10;/&#10;AVG(IF [test preparation course] = &quot;None&quot; THEN [Calculation_0750413901283328] END)' />
      </column>
