    <worksheet name='Test Prep Impact'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Test Prep Impact</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='StudentsPerformance' name='federated.1it6u1d0tbgidw0zwlf5711wgzc7' />
          </datasources>
          <datasource-dependencies datasource='federated.1it6u1d0tbgidw0zwlf5711wgzc7'>
            <column caption='Avg Score ' datatype='real' name='[Calculation_0750413901283328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([math score]+[writing score]+[reading score])/3' />
            </column>
            <column caption='Performance Category' datatype='string' name='[Calculation_0750413901750273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0750413901283328] &gt;= 75 THEN &quot;High Performer&quot;&#10;ELSEIF [Calculation_0750413901283328] &gt;= 50 THEN &quot;Average&quot;&#10;ELSE &quot;At Risk&quot;&#10;END' />
            </column>
            <column caption='Test Prep Impact %' datatype='real' name='[Calculation_0761409024847873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;AVG(IF [test preparation course] = &quot;Completed&quot; THEN [Calculation_0750413901283328] END)&#10;-&#10;AVG(IF [test preparation course] = &quot;None&quot; THEN [Calculation_0750413901283328] END)&#10;)&#10;/&#10;AVG(IF [test preparation course] = &quot;None&quot; THEN [Calculation_0750413901283328] END)' />
            </column>
            <column-instance column='[Calculation_0750413901283328]' derivation='Avg' name='[avg:Calculation_0750413901283328:qk]' pivot='key' type='quantitative' />
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column caption='Lunch' datatype='string' name='[lunch]' role='dimension' type='nominal' />
            <column caption='Math Score' datatype='integer' name='[math score]' role='measure' type='quantitative' />
            <column-instance column='[gender]' derivation='None' name='[none:gender:nk]' pivot='key' type='nominal' />
            <column-instance column='[lunch]' derivation='None' name='[none:lunch:nk]' pivot='key' type='nominal' />
            <column-instance column='[test preparation course]' derivation='None' name='[none:test preparation course:nk]' pivot='key' type='nominal' />
            <column caption='Reading Score' datatype='integer' name='[reading score]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0750413901283328]' derivation='Sum' name='[sum:Calculation_0750413901283328:qk]' pivot='key' type='quantitative' />
            <column caption='Test Preparation Course' datatype='string' name='[test preparation course]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0761409024847873]' derivation='User' name='[usr:Calculation_0761409024847873:qk]' pivot='key' type='quantitative' />
            <column caption='Writing Score' datatype='integer' name='[writing score]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1it6u1d0tbgidw0zwlf5711wgzc7].[Action (Performance Category)]'>
